{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": false,
    "baseUrl": ".",
    "paths": {
      "@snapui/core": ["packages/core/dist/index.d.ts"],
      "@snapui/generators": ["packages/generators/dist/index.d.ts"],
      "snapui-core": ["packages/core/dist/index.d.ts"],
      "snapui-generators": ["packages/generators/dist/index.d.ts"]
    }
  }
}
